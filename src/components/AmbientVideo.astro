---
/**
 * Ambient background video: a muted, decorative loop behind content.
 * Brand rules live in XTEND-AI-WEB.md §12.5; the pipeline that makes the
 * clips is scripts/make-ambient-video.mjs.
 *
 * The video is an enhancement that is never part of first paint, and the
 * still underneath it is what keeps Largest Contentful Paint honest:
 * - A full-bleed clip is larger than the watermark (the old LCP element).
 *   Measured with Lighthouse on a build that starts the clip at load:
 *   Chrome DOES register a video that fades in from opacity 0 as the LCP
 *   element, timed at its first visible frame. In production that would be
 *   load + delay + download, a late LCP that lab runs never see because
 *   they end before the clip exists.
 * - So pass `desktopStill` / `mobileStill` for any clip that can out-size
 *   the page's other content. The still is the clip's own first frame,
 *   painted with the page at full strength (never from opacity 0, never
 *   inside a wrapper that animates from 0). It becomes the LCP element at
 *   an early, truthful time, and the video, occupying the identical box,
 *   is never LARGER, so it cannot replace it. The clip then fades in over
 *   a pixel-identical frame: the picture simply starts to move. Visitors
 *   who get no video keep the still.
 * - The <video> itself carries NO `autoplay`, NO `src` and NO `poster`.
 * - The script assigns `src` only after `load` + a delay + idle, and only
 *   when nothing says "don't": reduced motion, Save-Data, 2g/3g, low
 *   device memory, a stored user choice, a hidden tab, or a box that is
 *   off screen. The global reduced-motion CSS block cannot stop a <video>,
 *   which is why this guard is in JS.
 * - If the browser refuses playback (iOS Low Power Mode), the download is
 *   cancelled. No retry: the user asked the device to save power.
 *
 * Pair it with <AmbientToggle /> in the same section: auto-starting motion
 * longer than five seconds needs a pause control (WCAG 2.2.2, Level A).
 * The toggle is wired here and also serves other motion sources on the page
 * (see the `data-motion` contract in the script).
 *
 * Knobs are inherited custom properties, set by the page on any ancestor
 * (same convention as the `--rise-*` entrance knobs):
 *   --ambient-video-opacity   how strong the clip is once playing
 *   --ambient-video-fade      fade-in duration
 *   --ambient-video-rate      playback rate, 0.5 to 1 (slower = calmer)
 *   --ambient-position        object-position of the clip
 *   --ambient-max-height      clamps the box (e.g. to the first screen)
 *   --ambient-scrim-color     what the edges fade to; the surface behind
 *   --ambient-fade-left-start / --ambient-fade-left   left scrim stops
 *   --ambient-fade-top-start  / --ambient-fade-top    top scrim stops
 *   --ambient-fade-bottom                             bottom scrim end
 *   --ambient-plate-size / -at / -strength   a soft dark ellipse behind a
 *       text block, so a bright clip can run under text without costing
 *       its contrast (size e.g. `44% 62%`, at e.g. `26% 58%`, strength %)
 */
import { getImage } from 'astro:assets';

interface Props {
  /** URL of the landscape rendition (import the .mp4 from src/assets/video/). */
  desktop: string;
  /** URL of the portrait rendition, used where `desktopMedia` does not match. */
  mobile?: string;
  /** First frame of `desktop` (the .png the pipeline writes beside it). */
  desktopStill?: ImageMetadata;
  /** First frame of `mobile`. */
  mobileStill?: ImageMetadata;
  /**
   * Where the landscape clip AND still apply. One query drives both, so the
   * video always fades in over the still of the same rendition. Match it to
   * the layout breakpoint at which the box turns from tall to wide.
   */
  desktopMedia?: string;
  /**
   * Optional opening clip, played ONCE per browser session before the loop.
   * It must begin and end on the loop's first frame (generate it with that
   * frame as both start and end image): it then rises out of the still and
   * hands off to the loop without a visible seam.
   */
  intro?: string;
  introMobile?: string;
  /**
   * Milliseconds after `load` before the clip may start. The default keeps a
   * background clip out of the page's way; an opening clip that is part of
   * the page's entrance wants to start sooner.
   */
  startDelay?: number;
  /** Never load video below this viewport width in px. */
  minWidth?: number;
}

const { desktop, mobile, desktopStill, mobileStill, desktopMedia = '(min-width: 1024px)', intro, introMobile, startDelay = 2500, minWidth = 0 } = Astro.props;

/* WebP at quality 70: about 22 KB desktop / 15 KB mobile for this footage.
   Deliberately not squeezed further: Chrome drops images under roughly
   0.05 bits per displayed pixel from LCP as placeholders, and the whole
   point of the still is to BE the LCP element. */
const stillD = desktopStill && (await getImage({ src: desktopStill, widths: [960, 1280, 1600], format: 'webp', quality: 70 }));
const stillM = mobileStill && (await getImage({ src: mobileStill, widths: [360, 540], format: 'webp', quality: 70 }));
const stillBase = stillM || stillD;

/* Worst-case measurement only: `AMBIENT_DELAY_MS=0 npm run build` starts
   every clip at load so Lighthouse and the LCP check see it. */
const delay = Number(process.env.AMBIENT_DELAY_MS ?? startDelay);
---

<div class="ambient" data-ambient data-delay={delay} data-min-width={minWidth} data-desktop-media={desktopMedia}>
  <div class="ambient__media" aria-hidden="true">
    {stillBase && (
      <picture>
        {stillM && stillD && <source media={desktopMedia} srcset={stillD.srcSet.attribute} sizes="100vw" type="image/webp" />}
        <img
          class="ambient__still"
          src={stillBase.src}
          srcset={stillBase.srcSet.attribute}
          sizes="100vw"
          width={stillBase.attributes.width}
          height={stillBase.attributes.height}
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    )}
    <video
      class="ambient__video"
      data-role="loop"
      muted
      loop
      playsinline
      preload="none"
      tabindex="-1"
      disablepictureinpicture
      disableremoteplayback
      data-src-desktop={desktop}
      data-src-mobile={mobile ?? desktop}
    ></video>
    {intro && (
      <video
        class="ambient__video ambient__video--intro"
        data-role="intro"
        muted
        playsinline
        preload="none"
        tabindex="-1"
        disablepictureinpicture
        disableremoteplayback
        data-src-desktop={intro}
        data-src-mobile={introMobile ?? intro}
      ></video>
    )}
    <div class="ambient__scrim"></div>
  </div>
</div>

<script>
  const KEY = 'xt-ambient';
  const root = document.documentElement;
  const boxes = [...document.querySelectorAll<HTMLElement>('[data-ambient]')];
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-ambient-toggle]')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const nav = navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string }; deviceMemory?: number };

  /** The visitor or the device asked for less; never load video then. */
  const constrained = () =>
    reduced.matches ||
    nav.connection?.saveData === true ||
    /^(slow-2g|2g|3g)$/.test(nav.connection?.effectiveType ?? '') ||
    (nav.deviceMemory ?? 8) <= 2;

  let userOff = false;
  try { userOff = localStorage.getItem(KEY) === 'off'; } catch { /* storage blocked */ }

  // The opening clip plays once per browser session; after that, straight
  // to the loop.
  const INTRO_KEY = 'xt-ambient-intro';
  let introSeen = false;
  try { introSeen = sessionStorage.getItem(INTRO_KEY) === '1'; } catch { /* storage blocked */ }

  const states = boxes.map((box) => {
    const loop = box.querySelector('video[data-role="loop"]') as HTMLVideoElement;
    const intro = introSeen ? null : (box.querySelector('video[data-role="intro"]') as HTMLVideoElement | null);
    return {
      box,
      loop,
      intro,
      video: intro ?? loop, // the element currently responsible for playback
      minWidth: Number(box.dataset.minWidth ?? 0),
      armed: false,
      inView: false,
      blocked: false,
      wanted: false,
    };
  });

  /** One media query picks both the still and the clip, so they always match. */
  const pick = (box: HTMLElement, v: HTMLVideoElement) =>
    (matchMedia(box.dataset.desktopMedia ?? '(min-width: 1024px)').matches ? v.dataset.srcDesktop : v.dataset.srcMobile) as string;

  // Other decorative motion on the page (HeroTesseract.astro) shares the
  // toggle: a source marks its root `data-motion` while it is able to animate
  // and `data-motion-playing` while it is, and dispatches `xt-motion` on
  // document at each change. The state lives in the DOM, so the order the
  // component scripts run in cannot matter.
  const motionPlaying = () => document.querySelector('[data-motion-playing]') !== null;
  const motionCapable = () => document.querySelector('[data-motion]') !== null;

  function paint() {
    root.toggleAttribute('data-ambient-off', userOff);
    const anyPlaying = states.some((s) => s.box.classList.contains('is-playing')) || motionPlaying();
    const resumable = states.some((s) => s.armed && !s.blocked) || motionCapable();
    for (const t of toggles) {
      // Shown while something plays, or when the visitor paused it (so it
      // can be resumed). Never shown where motion is unavailable anyway.
      t.hidden = !(anyPlaying || (userOff && !constrained() && resumable));
      t.setAttribute('aria-pressed', String(userOff));
      t.setAttribute('aria-label', userOff ? 'Play background motion' : 'Pause background motion');
    }
  }

  function start(s: (typeof states)[number]) {
    const v = s.video;
    if (!v.src) {
      v.src = pick(s.box, v);
      if (v === s.loop) {
        const rate = parseFloat(getComputedStyle(s.box).getPropertyValue('--ambient-video-rate'));
        if (rate > 0) v.defaultPlaybackRate = v.playbackRate = rate;
      }
    }
    v.muted = true;
    s.wanted = true;
    v.play().catch((err: DOMException) => {
      if (err.name !== 'NotAllowedError') return; // AbortError = our own pause() mid-load
      s.blocked = true;
      s.wanted = false;
      v.removeAttribute('src');
      v.load(); // cancels the download
      s.box.classList.remove('is-playing', 'is-intro', 'is-loop');
      paint();
    });
  }

  function stop(s: (typeof states)[number]) {
    s.wanted = false;
    if (!s.video.paused) s.video.pause();
  }

  function sync() {
    for (const s of states) {
      const want =
        s.armed && s.inView && !userOff && !s.blocked && !constrained() &&
        !document.hidden && innerWidth >= s.minWidth && s.box.offsetParent !== null;
      if (want) start(s); else stop(s);
    }
    paint();
  }

  if (states.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const s = states.find((x) => x.box === e.target);
        if (s) s.inView = e.isIntersecting;
      }
      sync();
    }, { threshold: 0.15 });

    for (const s of states) {
      io.observe(s.box);

      // `is-playing` = something is showing motion (drives the toggle);
      // `is-intro` / `is-loop` = which layer is visible.
      s.loop.addEventListener('playing', () => {
        s.box.classList.add('is-playing', 'is-loop');
        s.box.classList.remove('is-intro'); // intro fades away over the running loop
        paint();
      });

      if (s.intro) {
        const intro = s.intro;
        intro.addEventListener('playing', () => { s.box.classList.add('is-playing', 'is-intro'); paint(); });
        // Buffer the loop during the intro's last moments so the handoff
        // has nothing to wait for.
        intro.addEventListener('timeupdate', () => {
          if (!s.loop.src && intro.duration && intro.currentTime > intro.duration - 2) {
            s.loop.preload = 'auto';
            s.loop.src = pick(s.box, s.loop);
          }
        });
        // The intro ends on the loop's first frame, so the loop simply
        // takes over. The same path covers a failed intro.
        const handoff = () => {
          try { sessionStorage.setItem(INTRO_KEY, '1'); } catch { /* storage blocked */ }
          s.video = s.loop;
          s.intro = null;
          s.box.classList.add('is-handoff'); // loop appears instantly, no slow fade
          sync();
        };
        intro.addEventListener('ended', handoff, { once: true });
        intro.addEventListener('error', handoff, { once: true });
      }

      // A pause we did not ask for (power saving kicked in): hide the frozen
      // frame rather than leave a stalled picture behind the content.
      for (const v of [s.loop, s.intro]) {
        v?.addEventListener('pause', () => {
          if (s.wanted && v === s.video && !v.ended) { s.box.classList.remove('is-playing', 'is-intro', 'is-loop'); paint(); }
        });
      }
    }

    for (const t of toggles) {
      t.addEventListener('click', () => {
        userOff = !userOff;
        try { localStorage.setItem(KEY, userOff ? 'off' : 'on'); } catch { /* storage blocked */ }
        sync();
      });
    }

    document.addEventListener('visibilitychange', sync);
    document.addEventListener('xt-motion', paint); // another motion source started or stopped
    addEventListener('pageshow', (e) => { if (e.persisted) sync(); }); // bfcache restore fires no observer
    reduced.addEventListener('change', sync);

    const arm = () => { for (const s of states) s.armed = true; sync(); };
    const delay = Math.max(0, ...states.map((s) => Number(s.box.dataset.delay ?? 0)));
    const afterLoad = () => setTimeout(() => ('requestIdleCallback' in window ? requestIdleCallback(arm, { timeout: 2000 }) : arm()), delay);
    if (document.readyState === 'complete') afterLoad(); else addEventListener('load', afterLoad, { once: true });

    paint();
  }
</script>

<style>
  .ambient {
    position: absolute;
    inset: 0;
    max-height: var(--ambient-max-height, none);
    overflow: hidden;
    pointer-events: none;
    /* Own stacking context: the layers inside carry z-indexes (intro 1,
       scrim 2) that must never compete with the page's content (which sits
       at z-index 1), or the scrim ends up dimming the text it protects. */
    isolation: isolate;
  }

  .ambient__media {
    position: absolute;
    inset: 0;
  }

  /* Same box, same fit, same strength as the clip that fades in over it.
     Static and visible from first paint: this is the LCP element. */
  .ambient__still,
  .ambient__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: var(--ambient-position, center);
  }

  /* The clip crossfades over its own first frame at full opacity, so the
     handover is invisible. Intensity is NOT opacity on these two layers
     (that would dip or ghost mid-fade, and group opacity would cost an
     offscreen pass per video frame): it is the veil in the scrim below. */
  .ambient__video {
    opacity: 0;
    transition: opacity var(--ambient-video-fade, 2400ms) ease;
  }

  .ambient.is-loop .ambient__video[data-role='loop'],
  .ambient.is-intro .ambient__video--intro {
    opacity: 1;
  }

  /* The opening clip rides above the loop. It starts and ends on the
     still's frame, so it can appear and leave quickly without a pop. */
  .ambient__video--intro {
    z-index: 1;
    transition: opacity 500ms ease;
  }

  /* Taking over from the intro: the loop must already be fully there when
     the intro lifts away, not mid-way through its own slow fade-in. */
  .ambient.is-handoff .ambient__video[data-role='loop'] {
    transition: none;
  }

  /* Static gradient layers over the clip, not a mask on it: masking a
     playing video costs an offscreen pass per frame. This works because
     only the section's own surface sits beneath the clip. The last layer
     is the intensity veil: surface colour at (1 - opacity), which is
     exactly the clip at `--ambient-video-opacity` over that surface. */
  .ambient__scrim {
    --scrim: var(--ambient-scrim-color, var(--xt-bg-primary));
    --veil: color-mix(in srgb, var(--scrim) calc((1 - var(--ambient-video-opacity, 0.6)) * 100%), transparent);
    position: absolute;
    inset: 0;
    z-index: 2; /* above both clips; the intro sits at 1 */
    background:
      radial-gradient(
        ellipse var(--ambient-plate-size, 0% 0%) at var(--ambient-plate-at, 50% 50%),
        color-mix(in srgb, var(--scrim) var(--ambient-plate-strength, 0%), transparent) 0%,
        color-mix(in srgb, var(--scrim) calc(var(--ambient-plate-strength, 0%) * 0.75), transparent) 45%,
        transparent 100%
      ),
      linear-gradient(to right, var(--scrim) var(--ambient-fade-left-start, 0%), transparent var(--ambient-fade-left, 0%)),
      linear-gradient(to bottom, var(--scrim) var(--ambient-fade-top-start, 0%), transparent var(--ambient-fade-top, 0%)),
      linear-gradient(to top, var(--scrim) 0%, transparent var(--ambient-fade-bottom, 0%)),
      linear-gradient(var(--veil), var(--veil));
  }
</style>
