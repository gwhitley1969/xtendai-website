---
interface Props {
  title: string;
  description: string;
  icon?: string;
  /**
   * `center` suits short, glanceable copy (home-page teasers).
   * `start` suits a full paragraph — centred text becomes hard to
   * track past about two lines.
   */
  align?: 'center' | 'start';
}

const { title, description, icon = 'default', align = 'center' } = Astro.props;

const icons: Record<string, string> = {
  web: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="6" y="10" width="36" height="28" rx="4" stroke="currentColor" stroke-width="2"/>
    <path d="M6 19H42" stroke="currentColor" stroke-width="2"/>
    <circle cx="12" cy="14.5" r="1.5" fill="currentColor"/>
    <circle cx="17" cy="14.5" r="1.5" fill="currentColor"/>
    <circle cx="22" cy="14.5" r="1.5" fill="currentColor"/>
  </svg>`,
  mobile: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="14" y="6" width="20" height="36" rx="4" stroke="currentColor" stroke-width="2"/>
    <path d="M21 11H27" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <circle cx="24" cy="36" r="1.5" fill="currentColor"/>
  </svg>`,
  cloud: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M35 34H14C9.58 34 6 30.42 6 26C6 22.06 8.85 18.79 12.6 18.13C13.74 12.93 18.42 9 24 9C30.08 9 35.11 13.63 35.87 19.6C39.36 20.35 42 23.42 42 27.1C42 30.91 38.81 34 35 34Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
  </svg>`,
  multimodal: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2"/>
    <circle cx="16" cy="20" r="4" stroke="currentColor" stroke-width="2"/>
    <circle cx="32" cy="20" r="4" stroke="currentColor" stroke-width="2"/>
    <path d="M16 32C16 32 20 36 24 36C28 36 32 32 32 32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>`,
  purpose: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2"/>
    <circle cx="24" cy="24" r="12" stroke="currentColor" stroke-width="2"/>
    <circle cx="24" cy="24" r="4" fill="currentColor"/>
  </svg>`,
  human: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M24 8L28 16H20L24 8Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
    <circle cx="24" cy="28" r="12" stroke="currentColor" stroke-width="2"/>
    <path d="M18 28H30" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M24 22V34" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>`,
  chat: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M8 12C8 9.79 9.79 8 12 8H36C38.21 8 40 9.79 40 12V28C40 30.21 38.21 32 36 32H16L8 40V12Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
    <circle cx="18" cy="20" r="2" fill="currentColor"/>
    <circle cx="24" cy="20" r="2" fill="currentColor"/>
    <circle cx="30" cy="20" r="2" fill="currentColor"/>
  </svg>`,
  voice: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="18" y="8" width="12" height="20" rx="6" stroke="currentColor" stroke-width="2"/>
    <path d="M12 24C12 30.627 17.373 36 24 36C30.627 36 36 30.627 36 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M24 36V42" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M18 42H30" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>`,
  scanner: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <rect x="8" y="8" width="32" height="32" rx="4" stroke="currentColor" stroke-width="2"/>
    <path d="M8 18H14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M34 18H40" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M8 30H14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M34 30H40" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <circle cx="24" cy="24" r="8" stroke="currentColor" stroke-width="2"/>
  </svg>`,
  create: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M24 8V40" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M8 24H40" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <circle cx="24" cy="24" r="16" stroke="currentColor" stroke-width="2"/>
  </svg>`,
  share: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="36" cy="12" r="6" stroke="currentColor" stroke-width="2"/>
    <circle cx="12" cy="24" r="6" stroke="currentColor" stroke-width="2"/>
    <circle cx="36" cy="36" r="6" stroke="currentColor" stroke-width="2"/>
    <path d="M17 21L31 15" stroke="currentColor" stroke-width="2"/>
    <path d="M17 27L31 33" stroke="currentColor" stroke-width="2"/>
  </svg>`,
  default: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2"/>
    <path d="M24 16V32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M16 24H32" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
  </svg>`
};
---

<div class:list={['feature-card', 'card', `feature-card--${align}`]}>
  <div class="feature-card__icon" set:html={icons[icon] || icons.default} />
  <h3 class="feature-card__title">{title}</h3>
  <p class="feature-card__description">{description}</p>
</div>

<style>
  .feature-card {
    padding: var(--space-8);
  }

  .feature-card--center {
    text-align: center;
  }

  .feature-card--start {
    text-align: left;
  }

  .feature-card__icon {
    width: 48px;
    height: 48px;
    margin: 0 0 var(--space-4);
    color: var(--xt-accent);
  }

  .feature-card--center .feature-card__icon {
    margin-left: auto;
    margin-right: auto;
  }

  .feature-card__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .feature-card__title {
    font-size: 1.125rem;
    margin-bottom: var(--space-3);
    color: var(--xt-text-primary);
  }

  .feature-card__description {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--xt-text-secondary);
    margin: 0;
  }
</style>
