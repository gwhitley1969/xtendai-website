interface Props {
  name: string;
}

const { name } = Astro.props;
const svg = icons[name];

/* Pages are prerendered, so a typo'd name fails `npm run build` (the
   only CI gate) instead of silently rendering nothing in production. */
if (!svg) {
  throw new Error(`Icon "${name}" is not in the Icon.astro dictionary`);
}
---

