---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Services', href: '/services' },
  { label: 'Work', href: '/work' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' }
];

/**
 * Nav section that owns a URL which is not itself a nav destination.
 * Product detail pages live under /products but are reached from Work,
 * so Work stays lit while a visitor reads one. Without this the header
 * shows no active item at all on those pages.
 */
const navSectionFor: Record<string, string> = {
  '/products': '/work'
};

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  if (currentPath.startsWith(href)) return true;

  const owningPrefix = Object.keys(navSectionFor).find((prefix) =>
    currentPath.startsWith(prefix)
  );
  return owningPrefix !== undefined && navSectionFor[owningPrefix] === href;
}
---

<header class="header">
  <div class="header__container container">
    <a href="/" class="header__logo" aria-label="Xtend-AI Home">
      <img src="/images/Xtend-AI_logo_primary_white.png" alt="Xtend-AI" width="220" height="60">
      <span class="header__tagline">Web, mobile, and the cloud beneath</span>
    </a>

    <nav class="header__nav" aria-label="Main navigation">
      <ul class="nav__list">
        {navItems.map((item) => (
          <li class="nav__item">
            <a
              href={item.href}
              class={`nav__link ${isActive(item.href) ? 'nav__link--active' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button class="header__toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
    </button>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <nav aria-label="Mobile navigation">
    <ul class="mobile-menu__list">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class={`mobile-menu__link ${isActive(item.href) ? 'mobile-menu__link--active' : ''}`}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    background: rgba(10, 10, 15, 0.8);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    z-index: 100;
  }

  .header__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header__logo img {
    height: 48px;
    width: auto;
  }

  .header__tagline {
    font-size: 0.65rem;
    color: #ffffff;
    font-weight: 700;
    white-space: nowrap;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
  }

  @media (min-width: 768px) {
    .header__tagline {
      font-size: 0.85rem;
    }
  }

  @media (min-width: 1100px) {
    .header__tagline {
      font-size: 0.9rem;
    }
  }

  .header__nav {
    display: none;
  }

  @media (min-width: 900px) {
    .header__nav {
      display: block;
    }
  }

  .nav__list {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav__item {
    position: relative;
  }

  .nav__link {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-4);
    color: var(--xt-text-secondary);
    font-weight: 500;
    text-decoration: none;
    border-radius: var(--radius);
    transition: all var(--transition-fast);
  }

  .nav__link:hover {
    color: var(--xt-text-primary);
    background: rgba(24, 140, 255, 0.1);
  }

  .nav__link--active {
    color: var(--xt-accent-light);
  }

  /* Mobile Toggle */
  .header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: none;
    border: none;
    cursor: pointer;
  }

  @media (min-width: 900px) {
    .header__toggle {
      display: none;
    }
  }

  .header__toggle-bar {
    width: 24px;
    height: 2px;
    background: var(--xt-text-primary);
    border-radius: 1px;
    transition: all var(--transition-fast);
  }

  .header__toggle[aria-expanded="true"] .header__toggle-bar:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }

  .header__toggle[aria-expanded="true"] .header__toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .header__toggle[aria-expanded="true"] .header__toggle-bar:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Mobile Menu */
  .mobile-menu {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--xt-bg-primary);
    padding: var(--space-4);
    transform: translateX(100%);
    transition: transform var(--transition-base);
    overflow-y: auto;
    z-index: 99;
  }

  .mobile-menu[aria-hidden="false"] {
    transform: translateX(0);
  }

  @media (min-width: 900px) {
    .mobile-menu {
      display: none;
    }
  }

  .mobile-menu__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .mobile-menu__link {
    display: block;
    padding: var(--space-4);
    color: var(--xt-text-primary);
    font-size: 1.125rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mobile-menu__link--active {
    color: var(--xt-accent-light);
  }

  .mobile-menu__link:hover {
    color: var(--xt-accent-light);
  }

  /* Spacer for fixed header */
  :global(body) {
    padding-top: var(--header-height);
  }
</style>

<script>
  const toggle = document.querySelector('.header__toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggle && mobileMenu) {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.setAttribute('aria-hidden', String(isExpanded));
      document.body.style.overflow = isExpanded ? '' : 'hidden';
    });

    // Close menu on link click
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        mobileMenu.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      });
    });
  }
</script>
