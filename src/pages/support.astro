---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'App Support | Xtend-AI';
const description = 'Help with My AI Bartender and CLIQUE Pix. FAQs, bug reports, and support contact. For new project inquiries, see Services.';

const faqs = [
  { question: 'How do I get started with My AI Bartender?', answer: 'Download the app from the App Store or Google Play, create an account, and start by scanning your bottles or manually adding what you have at home. Then just ask the bartender for recommendations!' },
  { question: 'Is My AI Bartender free?', answer: 'My AI Bartender comes with a free three-day trial so you can explore the app and its AI features. During the trial you get limited access. After three days your account automatically rolls into a monthly subscription at $7.99/month with full access to all AI-powered features. Prefer to save? Skip the trial and subscribe annually at $79.99/year.' },
  { question: 'What devices are supported?', answer: 'My AI Bartender is available on iOS (iPhone and iPad) and Android devices. We recommend using a device with a camera for the bottle scanning feature.' },
  { question: 'How do I share a recipe with friends?', answer: 'Open any recipe in your vault and tap the Share button. You can generate a link that your friends can use to view the recipe.' },
  { question: 'I found a bug. How do I report it?', answer: 'We appreciate bug reports! Please email us at support@xtend-ai.com with details about what happened, your device type, and app version. Screenshots are helpful too.' }
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <section class="page-header">
    <div class="page-header__glow"></div>
    <div class="container text-center">
      <span class="badge">App Support</span>
      <h1>How can we <span class="text-gradient">help</span>?</h1>
      <p class="page-header__subtitle">Help with My AI Bartender and CLIQUE Pix</p>
    </div>
  </section>

  <!--
    Scopes the page explicitly. A prospective client who lands here by
    accident must not conclude that Xtend-AI is a support desk. Same
    reason Support is footer-only in the navigation.
  -->
  <section class="scope-section">
    <div class="container">
      <div class="scope-note">
        <p>
          <strong>This page is for help with our apps</strong> — My AI Bartender and
          CLIQUE Pix. If you're a business looking to hire us to build a website or an
          app, start at <a href="/services">Services</a> or <a href="/contact">Contact</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="support-grid">
        <div class="support-card card card--glow">
          <div class="icon-circle icon-circle--accent">✉️</div>
          <h2>Email Support</h2>
          <p>Have a question or a bug to report? Email us and you'll get a real answer.</p>
          <a href="mailto:support@xtend-ai.com" class="btn btn--primary">Email Us</a>
        </div>

        <div class="support-card card">
          <div class="icon-circle icon-circle--blue">⏱️</div>
          <h2>Response Time</h2>
          <p>We typically respond within 24-48 hours during business days.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--glow">
    <div class="container">
      <h2 class="section-title text-center">Frequently Asked Questions</h2>
      <div class="faq-list">
        <h3 class="faq-group">My AI Bartender</h3>
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-question">{faq.question}</summary>
            <p class="faq-answer">{faq.answer}</p>
          </details>
        ))}
        <p class="faq-note">
          Questions about <strong>CLIQUE Pix</strong>? Email
          <a href="mailto:support@xtend-ai.com">support@xtend-ai.com</a> — we answer
          within 24–48 hours.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container text-center">
      <h2>Still need help?</h2>
      <p class="cta-text">Can't find what you're looking for? Reach out and we'll get back to you.</p>
      <a href="/contact" class="btn btn--primary btn--large">Contact Us</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .page-header {
    position: relative;
    padding: var(--space-20) 0;
    overflow: hidden;
  }

  .page-header__glow {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse at center, rgba(24, 140, 255, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .page-header .container {
    position: relative;
    z-index: 1;
  }

  .page-header h1 {
    margin: var(--space-4) 0 var(--space-2);
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .page-header__subtitle {
    font-size: 1.125rem;
    color: var(--xt-text-secondary);
    margin: 0;
  }

  .section-title {
    margin-bottom: var(--space-12);
  }

  /* Scope note */
  .scope-section {
    padding-bottom: var(--space-8);
  }

  .scope-note {
    max-width: 700px;
    margin: 0 auto;
    padding: var(--space-4) var(--space-6);
    background: rgba(24, 140, 255, 0.08);
    border: 1px solid rgba(24, 140, 255, 0.25);
    border-left: 3px solid var(--xt-accent);
    border-radius: var(--radius);
  }

  .scope-note p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .scope-note strong {
    color: var(--xt-text-primary);
  }

  .support-grid {
    display: grid;
    gap: var(--space-6);
    max-width: 700px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .support-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .support-card {
    padding: var(--space-8);
    text-align: center;
  }

  .support-card .icon-circle {
    margin: 0 auto var(--space-4);
    font-size: 1.5rem;
  }

  .support-card h2 {
    font-size: 1.25rem;
    margin-bottom: var(--space-3);
  }

  .support-card p {
    margin-bottom: var(--space-6);
  }

  .faq-list {
    max-width: 700px;
    margin: 0 auto;
  }

  .faq-group {
    font-size: 1.125rem;
    color: var(--xt-accent-light);
    margin-bottom: var(--space-2);
  }

  .faq-note {
    margin-top: var(--space-8);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .faq-note strong {
    color: var(--xt-text-primary);
  }

  .faq-item {
    padding: var(--space-4) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .faq-question {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 600;
    cursor: pointer;
    padding: var(--space-2) 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--xt-text-primary);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question::after {
    content: '+';
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--xt-accent);
    transition: transform var(--transition-fast);
  }

  .faq-item[open] .faq-question::after {
    content: '−';
  }

  .faq-answer {
    padding-top: var(--space-3);
    line-height: 1.7;
  }

  .cta-text {
    font-size: 1.125rem;
    margin-bottom: var(--space-8);
  }
</style>
