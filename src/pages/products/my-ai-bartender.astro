---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StoreLinks from '../../components/StoreLinks.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import bartenderIcon from '../../assets/my-ai-bartender-icon.png';

const title = 'My AI Bartender | Xtend-AI';
const description = 'Your personal AI bartender. Discover cocktails, make smarter substitutions, chat hands-free, and create your own recipes with AI assistance.';

const steps = [
  {
    number: '1',
    title: 'Build "My Bar"',
    description: 'Scan your bottles or manually add what you have at home to create your personal bar inventory.',
    color: 'accent'
  },
  {
    number: '2',
    title: 'Ask the bartender',
    description: 'Chat or talk with your AI bartender to get cocktail recommendations based on what you have.',
    color: 'blue'
  },
  {
    number: '3',
    title: 'Create & refine',
    description: 'Build your own recipes and get AI suggestions to perfect your creations.',
    color: 'coral'
  },
  {
    number: '4',
    title: 'Share with friends',
    description: 'Share your favorite recipes with friends using simple codes or links.',
    color: 'gold'
  }
];

const features = [
  { icon: 'message-circle', title: 'Chat', description: 'Ask for cocktails, ideas, substitutions, and step-by-step help.', color: 'blue' },
  { icon: 'microphone', title: 'Voice', description: 'Real-time voice bartender conversations, completely hands-free.', color: 'green' },
  { icon: 'camera', title: 'Scan My Bar', description: 'Use your camera to identify bottles and build your bar.', color: 'coral' },
  { icon: 'book', title: 'Recipe Vault', description: 'Save your favorites and build your personal collection.', color: 'gold' },
  { icon: 'palette', title: 'Create Studio', description: 'Build custom recipes with AI-powered suggestions.', color: 'accent' },
  { icon: 'link', title: 'Friends via Code', description: 'Share recipes instantly with simple codes or links.', color: 'green' }
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__glow"></div>
    <div class="hero__glow hero__glow--secondary"></div>
    <div class="hero__container container">
      <span class="badge badge--glow">Available Now</span>
      <h1 class="hero__title">My AI <span class="text-gradient">Bartender</span></h1>
      <div class="hero__app-icon">
        <Image
          src={bartenderIcon}
          alt=""
          width={120}
          height={120}
          densities={[2, 3]}
          loading="eager"
        />
      </div>
      <p class="hero__subtitle">
        Your personal AI bartender that helps you discover cocktails, make smarter substitutions,
        and use what you already have.
      </p>
      <div class="hero__actions">
        <StoreLinks
          appStore="https://apps.apple.com/us/app/my-ai-bartender-scan-create/id6758023541"
          googlePlay="https://play.google.com/store/apps/details?id=ai.mybartender.mybartenderai"
          appName="My AI Bartender"
          size="large"
        />
      </div>
    </div>
  </section>

  <!-- How It Works Section -->
  <section class="section">
    <div class="container">
      <h2 class="section-title text-center">How it <span class="text-gradient">works</span></h2>
      <div class="steps">
        {steps.map((step) => (
          <div class="step card">
            <div class={`step__number step__number--${step.color}`}>{step.number}</div>
            <div class="step__content">
              <h3 class="step__title">{step.title}</h3>
              <p class="step__description">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="section section--glow">
    <div class="container">
      <h2 class="section-title text-center">Key <span class="text-gradient">Features</span></h2>
      <div class="features-grid">
        {features.map((feature) => (
          <div class="feature-card card card--glow">
            <div class={`icon-circle icon-circle--${feature.color}`}><Icon name={feature.icon} /></div>
            <h3 class="feature-card__title">{feature.title}</h3>
            <p class="feature-card__description">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Responsible Use Section -->
  <section class="section">
    <div class="container">
      <div class="notice card">
        <div class="notice__icon">21+</div>
        <div class="notice__content">
          <h3 class="notice__title">Responsible Use</h3>
          <p class="notice__text">
            My AI Bartender is intended for users of legal drinking age (21+ in the US).
            Please enjoy responsibly and never drink and drive.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section">
    <div class="container">
      <div class="cta-card card card--glow">
        <div class="cta-card__glow"></div>
        <h2>Ready to discover your next favorite cocktail?</h2>
        <p>My AI Bartender is available now on the App Store and Google Play.</p>
        <a href="/contact" class="btn btn--primary btn--large">Contact Us</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: var(--space-20) 0;
    text-align: center;
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(ellipse at center, rgba(24, 140, 255, 0.25) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero__glow--secondary {
    top: 0;
    background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.15) 0%, transparent 50%);
  }

  .hero__container {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .badge--glow {
    background: linear-gradient(135deg, rgba(24, 140, 255, 0.3) 0%, rgba(59, 130, 246, 0.3) 100%);
    border: 1px solid rgba(24, 140, 255, 0.5);
    box-shadow: 0 0 20px rgba(24, 140, 255, 0.3);
  }

  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: var(--space-6) 0;
  }

  .hero__app-icon {
    width: 120px;
    height: 120px;
    margin: 0 auto var(--space-6);
  }

  .hero__app-icon :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 22%;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  }

  .hero__subtitle {
    font-size: 1.25rem;
    line-height: 1.7;
    margin-bottom: var(--space-8);
    color: var(--xt-text-secondary);
  }

  /* StoreLinks is a component, so its root needs :global() to be reached */
  .hero__actions :global(.store-links) {
    justify-content: center;
  }

  /* Section Title */
  .section-title {
    margin-bottom: var(--space-12);
  }

  /* Steps */
  .steps {
    display: grid;
    gap: var(--space-6);
    max-width: 900px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .step {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  .step__number {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    border-radius: 50%;
  }

  .step__number--accent {
    background: linear-gradient(135deg, rgba(24, 140, 255, 0.3) 0%, rgba(24, 140, 255, 0.1) 100%);
    color: var(--xt-accent-light);
    border: 1px solid rgba(24, 140, 255, 0.4);
  }

  .step__number--blue {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.3) 0%, rgba(59, 130, 246, 0.1) 100%);
    color: var(--xt-blue);
    border: 1px solid rgba(59, 130, 246, 0.4);
  }

  .step__number--coral {
    background: linear-gradient(135deg, rgba(244, 114, 182, 0.3) 0%, rgba(244, 114, 182, 0.1) 100%);
    color: var(--xt-coral);
    border: 1px solid rgba(244, 114, 182, 0.4);
  }

  .step__number--gold {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.3) 0%, rgba(251, 191, 36, 0.1) 100%);
    color: var(--xt-gold);
    border: 1px solid rgba(251, 191, 36, 0.4);
  }

  .step__title {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
  }

  .step__description {
    font-size: 0.9375rem;
    color: var(--xt-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    padding: var(--space-6);
    text-align: center;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
  }

  .feature-card .icon-circle {
    margin: 0 auto var(--space-4);
  }

  .feature-card__title {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
  }

  .feature-card__description {
    font-size: 0.9375rem;
    color: var(--xt-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  /* Notice */
  .notice {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
    max-width: 700px;
    margin: 0 auto;
    padding: var(--space-6);
    border: 1px solid rgba(251, 191, 36, 0.3);
    background: rgba(251, 191, 36, 0.05);
  }

  .notice__icon {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--xt-gold);
    background: rgba(251, 191, 36, 0.2);
    border: 2px solid var(--xt-gold);
    border-radius: 50%;
  }

  .notice__title {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
    color: var(--xt-gold);
  }

  .notice__text {
    font-size: 0.9375rem;
    color: var(--xt-text-secondary);
    margin: 0;
    line-height: 1.6;
  }

  /* CTA Card */
  .cta-card {
    position: relative;
    text-align: center;
    padding: var(--space-12);
    max-width: 700px;
    margin: 0 auto;
    overflow: hidden;
  }

  .cta-card__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(24, 140, 255, 0.2) 0%, transparent 60%);
    pointer-events: none;
  }

  .cta-card h2 {
    position: relative;
    font-size: 1.5rem;
    margin-bottom: var(--space-4);
  }

  .cta-card p {
    position: relative;
    font-size: 1.125rem;
    color: var(--xt-text-secondary);
    margin-bottom: var(--space-8);
  }

  .cta-card .btn {
    position: relative;
  }
</style>
