---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StoreLinks from '../../components/StoreLinks.astro';
import Icon from '../../components/Icon.astro';
import { Image } from 'astro:assets';
import cliquePixIcon from '../../assets/clique-pix-icon.png';

const title = 'CLIQUE Pix | Xtend-AI';
const description = 'Private, event-based group photo sharing on iOS, Android, and the web. Share photos and videos in real time, then let everything disappear when the moment is over.';

const appStore = 'https://apps.apple.com/us/app/clique-pix-group-pic-sharing/id6766294274';
const googlePlay = 'https://play.google.com/store/apps/details?id=com.cliquepix.clique_pix';

const features = [
  {
    icon: 'calendar',
    color: 'accent',
    title: 'Events',
    description: 'Create a temporary Event when you need to share around a single occasion.'
  },
  {
    icon: 'users',
    color: 'blue',
    title: 'Cliques',
    description: 'Or keep a persistent Clique for a group you share with regularly.'
  },
  {
    icon: 'bolt',
    color: 'gold',
    title: 'Real time',
    description: 'Snap and share photos and videos as the moment is happening.'
  },
  {
    icon: 'hourglass',
    color: 'green',
    title: 'Then it disappears',
    description: "Everything goes when the moment's over. Nothing lingers."
  }
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <!-- Hero -->
  <section class="hero">
    <div class="hero__glow"></div>
    <div class="hero__glow hero__glow--secondary"></div>
    <div class="hero__container container">
      <span class="badge badge--glow">Available Now</span>
      <h1 class="hero__title">CLIQUE <span class="text-gradient">Pix</span></h1>
      <div class="hero__app-icon">
        <Image
          src={cliquePixIcon}
          alt=""
          width={120}
          height={120}
          densities={[2, 3]}
          loading="eager"
        />
      </div>
      <p class="hero__subtitle">
        Private, event-based group photo sharing. Create temporary Events or persistent
        Cliques, snap and share photos and videos in real time, and let everything
        disappear when the moment is over.
      </p>
      <div class="hero__actions">
        <StoreLinks
          appStore={appStore}
          googlePlay={googlePlay}
          appName="CLIQUE Pix"
          size="large"
        />
      </div>
      <p class="hero__web">
        Or open it in your browser at <a href="https://clique-pix.com">clique-pix.com</a>
      </p>
    </div>
  </section>

  <!-- What it does -->
  <section class="section section--glow">
    <div class="container">
      <h2 class="section-title text-center">How it <span class="text-gradient">works</span></h2>
      <div class="features-grid">
        {features.map((feature) => (
          <div class="feature card card--glow">
            <div class={`icon-circle icon-circle--${feature.color}`}><Icon name={feature.icon} /></div>
            <h3 class="feature__title">{feature.title}</h3>
            <p class="feature__description">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Built with -->
  <section class="section">
    <div class="container">
      <div class="built card">
        <h2 class="built__title">Three surfaces, one backend</h2>
        <p class="built__text">
          A Flutter app for iOS and Android, a web client on Azure Static Web Apps at
          clique-pix.com, and a single Azure backend behind all three — same sign-in,
          same real-time updates, same photos, whichever one you open.
        </p>
        <p class="built__text">
          That is the same architecture we build client work on. Shipping our own
          products on it is how we know it holds.
        </p>
        <a href="/services" class="btn btn--secondary">See what we build for clients</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container text-center">
      <h2>Building something like this?</h2>
      <p class="cta-text">
        We ship our own apps end to end. We can ship yours the same way.
      </p>
      <a href="/contact" class="btn btn--primary btn--large">Start a project</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Hero — matches the My AI Bartender product page */
  .hero {
    position: relative;
    padding: var(--space-20) 0;
    text-align: center;
    overflow: hidden;
  }

  .hero__glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(ellipse at center, rgba(24, 140, 255, 0.25) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero__glow--secondary {
    top: 0;
    background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.15) 0%, transparent 50%);
  }

  .hero__container {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .badge--glow {
    background: linear-gradient(135deg, rgba(24, 140, 255, 0.3) 0%, rgba(59, 130, 246, 0.3) 100%);
    border: 1px solid rgba(24, 140, 255, 0.5);
    box-shadow: 0 0 20px rgba(24, 140, 255, 0.3);
  }

  .hero__title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: var(--space-6) 0;
  }

  .hero__app-icon {
    width: 120px;
    height: 120px;
    margin: 0 auto var(--space-6);
  }

  .hero__app-icon :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 22%;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  }

  .hero__subtitle {
    font-size: 1.25rem;
    line-height: 1.7;
    margin-bottom: var(--space-8);
    color: var(--xt-text-secondary);
  }

  /* StoreLinks is a component, so its root needs :global() to be reached */
  .hero__actions :global(.store-links) {
    justify-content: center;
  }

  .hero__web {
    margin-top: var(--space-6);
    font-size: 0.9375rem;
    color: var(--xt-text-muted);
  }

  .section-title {
    margin-bottom: var(--space-12);
  }

  /* Features */
  .features-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .features-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .feature {
    padding: var(--space-8);
    text-align: center;
  }

  .feature .icon-circle {
    margin: 0 auto var(--space-4);
    font-size: 1.5rem;
  }

  .feature__title {
    font-size: 1.125rem;
    margin-bottom: var(--space-2);
  }

  .feature__description {
    font-size: 0.9375rem;
    line-height: 1.7;
    margin: 0;
  }

  /* Built with */
  .built {
    padding: var(--space-12) var(--space-8);
    text-align: center;
    max-width: 720px;
    margin: 0 auto;
  }

  .built__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--space-4);
  }

  .built__text {
    font-size: 1.0625rem;
    line-height: 1.8;
    margin-bottom: var(--space-8);
  }

  .cta-text {
    font-size: 1.125rem;
    line-height: 1.8;
    max-width: 520px;
    margin: var(--space-4) auto var(--space-8);
  }
</style>
