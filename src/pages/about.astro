---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'About | Xtend-AI';
const description = 'Xtend-AI is a Charlotte-area studio led by a solutions architect with 30 years in enterprise infrastructure and cloud. Azure certified, published author.';

/**
 * Exam codes expanded to their standard Microsoft certification titles —
 * a business owner does not read "AZ-700". These are the canonical names
 * for those exams, not additional claims.
 */
const credentials = [
  { name: 'AZ-305', detail: 'Azure Solutions Architect Expert' },
  { name: 'AZ-104', detail: 'Azure Administrator Associate' },
  { name: 'AZ-700', detail: 'Azure Network Engineer Associate' },
  { name: 'AZ-900', detail: 'Azure Fundamentals' },
  { name: 'IBM Certified Architect', detail: 'Level 2 (Expert) — former' },
  { name: 'Open Group Certified Master Architect', detail: 'Former' },
  { name: 'Five technical books', detail: 'Contributing author' }
];

const values = [
  { icon: '✨', text: 'User experience comes first' },
  { icon: '📐', text: 'Architecture before code' },
  { icon: '🎯', text: 'AI should be helpful, not hype' },
  { icon: '🤝', text: 'Ship it, then stand behind it' }
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <section class="page-header">
    <div class="page-header__glow"></div>
    <div class="container">
      <span class="badge">About Us</span>
      <h1>Built by the person who <span class="text-gradient">builds it</span></h1>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="about-grid">
        <div class="about-content">
          <p class="lead">
            Xtend-AI designs and builds websites, mobile apps, and the cloud infrastructure
            underneath them — created by an architect with over thirty years in enterprise
            systems, not assembled from templates. We ship our own apps, which is how we
            know how to ship yours.
          </p>

          <p>
            Xtend-AI, LLC is a small studio based between Charlotte and Harrisburg, North
            Carolina. We design and build websites, mobile apps, and the Azure infrastructure
            that runs them for client companies — and we build and ship our own consumer apps
            on exactly the same stack.
          </p>

          <h2 class="about-heading">The architect</h2>

          <p>
            Xtend-AI was founded by <strong>Gene Whitley</strong>, a solutions architect with
            roughly thirty years in enterprise infrastructure and cloud architecture. Microsoft
            Azure certified, formerly an IBM Certified Architect at Level 2 (Expert) and an
            Open Group Certified Master Architect, and a contributing author on five published
            technical books.
          </p>

          <p>
            That background is why the work is architected rather than assembled. Static-first
            sites for speed, infrastructure defined as code, DNS delegated and managed properly,
            security headers and CI/CD configured on day one — the same discipline as enterprise
            systems, at the size of your business.
          </p>

          <p>
            It also means something simple about working with us: when you hire Xtend-AI, you
            are working with the person who designs the system and writes the code. There is no
            account manager, and no handoff to a junior team after the pitch.
          </p>
        </div>

        <aside class="about-aside">
          <div class="creds-card card card--glow">
            <h2 class="aside-title">Credentials</h2>
            <ul class="creds-list">
              {credentials.map((item) => (
                <li class="creds-item">
                  <strong class="creds-item__name">{item.name}</strong>
                  <span class="creds-item__detail">{item.detail}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="values-card card">
            <h2 class="aside-title">Our Values</h2>
            <ul class="values-list">
              {values.map((value) => (
                <li class="values-item">
                  <span class="values-icon">{value.icon}</span>
                  <span>{value.text}</span>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--glow">
    <div class="container text-center">
      <h2>Interested in working together?</h2>
      <p class="cta-text">
        Tell us what you're building and we'll come back with an architecture,
        a timeline, and a number.
      </p>
      <a href="/contact" class="btn btn--primary btn--large">Start a project</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .page-header {
    position: relative;
    padding: var(--space-20) 0;
    overflow: hidden;
  }

  .page-header__glow {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(ellipse at center, rgba(24, 140, 255, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .page-header .container {
    position: relative;
    z-index: 1;
  }

  .page-header h1 {
    margin-top: var(--space-4);
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .about-grid {
    display: grid;
    gap: var(--space-12);
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1.5fr 1fr;
      align-items: start;
    }
  }

  .about-content {
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .lead {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--xt-text-primary);
    margin-bottom: var(--space-6);
  }

  .about-heading {
    font-size: 1.5rem;
    margin: var(--space-12) 0 var(--space-4);
  }

  .about-content strong {
    color: var(--xt-text-primary);
  }

  .about-aside {
    display: grid;
    gap: var(--space-6);
  }

  .creds-card,
  .values-card {
    padding: var(--space-8);
  }

  .aside-title {
    font-size: 1.25rem;
    margin-bottom: var(--space-6);
  }

  /* Credentials */
  .creds-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .creds-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin: 0;
  }

  .creds-item:first-child {
    padding-top: 0;
  }

  .creds-item:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .creds-item__name {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--xt-text-primary);
  }

  .creds-item__detail {
    font-size: 0.875rem;
    color: var(--xt-text-secondary);
  }

  /* Values */
  .values-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .values-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-weight: 500;
    color: var(--xt-text-primary);
  }

  .values-item:last-child {
    border-bottom: none;
  }

  .values-icon {
    font-size: 1.25rem;
  }

  .cta-text {
    font-size: 1.125rem;
    line-height: 1.8;
    max-width: 560px;
    margin: var(--space-4) auto var(--space-8);
  }
</style>
