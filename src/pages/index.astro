---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Icon from '../components/Icon.astro';
import AmbientVideo from '../components/AmbientVideo.astro';
import AmbientToggle from '../components/AmbientToggle.astro';
import HeroTesseract from '../components/HeroTesseract.astro';
/* Imported, not served from public/: Vite emits content-hashed
   /assets/<name>.<hash>.mp4 URLs, and a missing clip fails the build. */
import flightDesktop from '../assets/video/beneath-flight-d.mp4';
import flightMobile from '../assets/video/beneath-flight-m.mp4';
import flightStillDesktop from '../assets/video/beneath-flight-d.png';
import flightStillMobile from '../assets/video/beneath-flight-m.png';

const title = 'Xtend-AI | Web & Mobile App Development in Charlotte, NC';
const description = 'Xtend-AI designs and builds websites, mobile apps, and the Azure cloud that runs them. Architected, not assembled. Charlotte & Harrisburg, NC, and remote.';

/**
 * Replaces the old Chat / Voice / Scan My Bar / Create bar, which was
 * My AI Bartender feature copy sitting on the company home page.
 *
 * Every value here is verifiable, and the 30 years is labelled as the
 * co-founder's career — not the company's age. Xtend-AI, LLC is young and
 * the copy must never blur the two.
 */
const credibility = [
  { value: 'Azure Certified', label: 'AZ-305 Solutions Architect Expert' },
  { value: '30 years', label: "Our co-founder's career in enterprise infrastructure" },
  { value: '2 apps shipped', label: 'Live on the App Store and Google Play' },
  { value: 'Charlotte / Harrisburg, NC', label: 'Local, and remote-friendly' }
];

const services = [
  {
    icon: 'web',
    title: 'Websites',
    description: 'Designed and built mobile-first. Fast, accessible, SEO-ready, and deployed as static files to a global CDN, not a page builder with a monthly subscription attached.'
  },
  {
    icon: 'mobile',
    title: 'Mobile apps',
    description: 'iOS and Android from a single Flutter codebase, with an Azure backend when the app needs one. We have shipped two of our own to both stores.'
  },
  {
    icon: 'cloud',
    title: 'Cloud & hosting',
    description: 'Azure architecture, infrastructure as code, custom domains and real DNS delegation, security headers, CI/CD on every push, and monitoring after launch.'
  }
];

const differentiators = [
  {
    icon: 'building',
    color: 'accent',
    title: 'Architected, not assembled',
    description: 'Static-first builds, infrastructure as code, real DNS delegation, security headers, CI/CD on every push, and per-client tenant isolation. The same discipline as enterprise systems, at the size of your business.'
  },
  {
    icon: 'puzzle',
    color: 'cyan',
    title: 'Both halves, one system',
    description: 'Website and mobile app on the same design system, with AI features only where they earn their place. One team, one look, one place to call.'
  },
  {
    icon: 'heart-handshake',
    color: 'green',
    title: 'Small, senior, direct',
    description: 'You talk to the architect who builds it. No account manager, and no handoff to a junior team after the pitch.'
  }
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />
  {/* Support diagnostics: with ?diag in the URL, script errors are captured
      from the very start (this runs before the bundled scripts) and shown by
      the panel at the end of this page's script. No effect otherwise. */}
  <script slot="head" is:inline>
    if (location.search.indexOf('diag') !== -1) {
      window.__xtErrors = [];
      addEventListener('error', function (e) { window.__xtErrors.push((e.message || 'error') + ' @' + String(e.filename || '').split('/').pop() + ':' + e.lineno); });
      addEventListener('unhandledrejection', function (e) { window.__xtErrors.push('rejection: ' + ((e.reason && e.reason.message) || e.reason)); });
    }
  </script>

  <!-- Hero Section -->
  <section class="hero">
    {/* The flight over the lattice, once per visit, then its first frame
        holds as the still. BEFORE .hero__bg, not inside it: .hero__bg blooms
        in from opacity 0, and the still must paint at full strength with the
        page to be the honest LCP element (see AmbientVideo.astro). The glows
        and grid still bloom in over it. */}
    <AmbientVideo
      intro={flightDesktop}
      introMobile={flightMobile}
      desktopStill={flightStillDesktop}
      mobileStill={flightStillMobile}
      desktopMedia="(min-width: 1024px)"
      startDelay={600}
    />
    <div class="hero__bg">
      <div class="hero__glow hero__glow--1"></div>
      <div class="hero__glow hero__glow--2"></div>
      <div class="hero__grid"></div>
    </div>
    <div class="hero__container container">
      <div class="hero__content">
        <h1 class="hero__title">
          Websites and apps, <span class="text-gradient">architected to last</span>
        </h1>
        <p class="hero__subtitle">
          Xtend-AI designs and builds websites, mobile apps, and the cloud infrastructure
          that runs them. You deal directly with the architect who builds it.
        </p>
        <div class="hero__actions">
          <a href="/services" class="btn btn--primary btn--large">
            <span>See what we build</span>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="/contact" class="btn btn--secondary btn--large">Start a project</a>
        </div>
      </div>
      <div class="hero__visual">
        {/* The tesseract: a 4-D cube of light with the lockup at its core,
            drawn live (HeroTesseract.astro). .hero__visual carries the
            entrance rise; the cube's own float lives inside the component. */}
        <HeroTesseract />
      </div>
    </div>
    {/* After .hero__container, not inside .hero__bg: the content grid
        (z-index 1) would otherwise swallow its clicks. */}
    <AmbientToggle />
  </section>

  <!-- Credibility Bar -->
  <section class="cred-bar">
    <div class="container">
      <div class="cred-bar__grid">
        {credibility.map((item) => (
          <div class="cred">
            <strong class="cred__value">{item.value}</strong>
            <span class="cred__label">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What We Do Section -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__content">
          <h2>Websites, apps, and<br>the cloud beneath them.</h2>
          <p>
            Most shops build one of the three and hand off the rest. We build all three,
            because they are the same problem: a site that loads fast, an app that ships
            to both stores, and Azure infrastructure that holds them up.
          </p>
          <p>
            Designed together on one system, not bolted together after the fact.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Teaser -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <h2>What we build</h2>
      </div>

      <div class="grid grid--3">
        {services.map((service) => (
          <FeatureCard
            icon={service.icon}
            title={service.title}
            description={service.description}
            align="start"
          />
        ))}
      </div>

      <div class="section__cta text-center">
        <a href="/services" class="btn btn--secondary btn--large">See what we build</a>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <h2>Work we're shipping</h2>
      </div>

      <div class="proof card">
        <p class="proof__text">
          We're building a website and a Flutter mobile app for <strong>Needle Girlie</strong>,
          a medical aesthetics practice in Harrisburg, NC. We've also shipped two apps of our
          own, <strong>My AI Bartender</strong> and <strong>CLIQUE Pix</strong>, live on the
          App Store and Google Play, with CLIQUE Pix also running on the web.
        </p>
        <a href="/work" class="btn btn--primary btn--large">
          See our work
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Why We're Different Section -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <h2>We don't assemble websites.<br>We architect systems.</h2>
      </div>

      <div class="diff-list">
        {differentiators.map((item) => (
          <div class="diff-row">
            <div class={`icon-circle icon-circle--${item.color}`}><Icon name={item.icon} /></div>
            <div class="diff-row__body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-card__glow"></div>
        <div class="cta-card__content">
          <h2>Let's talk about your project</h2>
          <p>
            Tell us what you're trying to build. You'll get a straight answer about whether
            we're the right fit. If we are, you'll get an architecture, a timeline, and a number.
          </p>
          <a href="/contact" class="btn btn--primary btn--large">Start a project</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  // Cred-bar scroll reveal. Arms the hidden state only when it can also
  // reveal it; without JS (or with reduced motion) the bar is simply
  // visible. The grid sits below the 100dvh hero, so the arming race
  // against first paint is invisible.
  const grid = document.querySelector('.cred-bar__grid');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (grid && !reduced && 'IntersectionObserver' in window) {
    grid.classList.add('is-pending');
    const io = new IntersectionObserver((entries) => {
      if (entries[0].isIntersecting) {
        grid.classList.add('is-revealed');
        io.disconnect();
      }
    }, { threshold: 0.3 });
    io.observe(grid);
  }

  // Support diagnostics: append ?diag to the URL. Shows the device signals
  // the hero's motion decisions depend on, the video and cube state, and any
  // script errors (captured by the inline listener in the head). Nothing is
  // rendered or run without the parameter.
  if (location.search.includes('diag')) {
    type Net = { saveData?: boolean; effectiveType?: string; rtt?: number; downlink?: number };
    const nav = navigator as Navigator & { connection?: Net; deviceMemory?: number };
    const panel = document.createElement('pre');
    panel.style.cssText = 'position:fixed;left:8px;bottom:8px;z-index:1000;max-width:92vw;max-height:60vh;overflow:auto;margin:0;padding:8px 10px;font:11px/1.4 ui-monospace,Menlo,Consolas,monospace;color:#fff;background:rgba(10,10,15,.92);border:1px solid rgba(255,255,255,.25);border-radius:8px;white-space:pre-wrap;word-break:break-word';
    document.body.appendChild(panel);
    const render = () => {
      const host = document.querySelector('[data-tess]') as (HTMLElement & { tess?: { state: Record<string, unknown> } }) | null;
      const v = document.querySelector<HTMLVideoElement>('video[data-role="intro"], video[data-role="loop"]');
      const box = document.querySelector('.ambient');
      let stored = 'n/a';
      try { stored = String(localStorage.getItem('xt-ambient')); } catch { /* storage blocked */ }
      const errors = (window as Window & { __xtErrors?: string[] }).__xtErrors ?? [];
      panel.textContent = [
        `ua: ${navigator.userAgent}`,
        `viewport: ${innerWidth}x${innerHeight} dpr ${devicePixelRatio} visibility ${document.visibilityState}`,
        `connection: saveData=${nav.connection?.saveData} effectiveType=${nav.connection?.effectiveType} rtt=${nav.connection?.rtt} downlink=${nav.connection?.downlink}`,
        `device: memory=${nav.deviceMemory} cores=${navigator.hardwareConcurrency} reducedMotion=${matchMedia('(prefers-reduced-motion: reduce)').matches} finePointer=${matchMedia('(pointer: fine)').matches}`,
        `ambient: ${box?.className ?? 'none'} off=${document.documentElement.hasAttribute('data-ambient-off')} stored=${stored}`,
        v ? `video: ${v.dataset.role} src=${v.getAttribute('src') ? 'yes' : 'no'} ready=${v.readyState} paused=${v.paused} t=${v.currentTime.toFixed(1)} rate=${v.playbackRate} error=${v.error?.code ?? '-'}` : 'video: none',
        `cube: ${host?.tess ? JSON.stringify(host.tess.state) : 'no state (script did not boot)'}`,
        `errors: ${errors.length ? errors.join(' | ') : 'none'}`,
      ].join('\n');
    };
    render();
    setInterval(render, 1000);
  }
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    /* dvh tracks the *visible* viewport on iOS (address bar collapse),
       so the CTA can't land below the fold on first paint. */
    min-height: calc(100dvh - var(--header-height));
    display: flex;
    align-items: center;
    padding: var(--space-12) 0;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.5;
  }

  .hero__glow--1 {
    width: 600px;
    height: 600px;
    background: var(--xt-accent);
    top: -200px;
    left: -200px;
    opacity: 0.15;
  }

  .hero__glow--2 {
    width: 500px;
    height: 500px;
    background: var(--xt-blue);
    bottom: -150px;
    right: -150px;
    opacity: 0.1;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(24, 140, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(24, 140, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }

  .hero__container {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__container {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero__content {
    text-align: center;
  }

  @media (min-width: 1024px) {
    .hero__content {
      text-align: left;
    }
  }

  .hero__title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin: var(--space-6) 0;
  }

  .hero__subtitle {
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    color: var(--xt-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-8);
    max-width: 540px;
  }

  @media (min-width: 1024px) {
    .hero__subtitle {
      margin-left: 0;
      margin-right: auto;
    }
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
  }

  @media (min-width: 480px) {
    .hero__actions {
      flex-direction: row;
    }
  }

  @media (min-width: 1024px) {
    .hero__actions {
      justify-content: flex-start;
    }
  }

  /* Hero Visual: the tesseract column */
  .hero__visual {
    display: flex;
    justify-content: center;
  }

  /* Credibility Bar */
  .cred-bar {
    padding: var(--space-8) 0;
    background: var(--xt-bg-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .cred-bar__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .cred-bar__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cred-bar__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cred {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 2px solid rgba(24, 140, 255, 0.4);
  }

  .cred__value {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--xt-text-primary);
  }

  .cred__label {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--xt-text-muted);
  }

  /* Split Content */
  .split {
    max-width: 700px;
  }

  .split__content h2 {
    margin: var(--space-4) 0 var(--space-6);
  }

  .split__content p {
    font-size: 1.125rem;
    line-height: 1.8;
  }

  /* Section Header */
  .section-header {
    margin-bottom: var(--space-12);
  }

  .section-header h2 {
    margin-bottom: var(--space-4);
  }

  /* Services teaser */
  .section__cta {
    margin-top: var(--space-12);
  }

  /* Proof */
  .proof {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-8);
    text-align: center;
  }

  .proof__text {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: var(--space-8);
  }

  .proof strong {
    color: var(--xt-accent-light);
    font-weight: 600;
  }

  /* Differentiators as editorial rows — the earlier three-equal-cards
     layout duplicated the services grid directly above it. */
  .diff-list {
    max-width: 800px;
    margin: 0 auto;
  }

  .diff-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-6);
    padding: var(--space-8) 0;
  }

  .diff-row:first-child {
    padding-top: 0;
  }

  .diff-row:last-child {
    padding-bottom: 0;
  }

  .diff-row + .diff-row {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .diff-row h3 {
    margin-bottom: var(--space-2);
  }

  .diff-row p {
    margin: 0;
    line-height: 1.7;
  }

  @media (max-width: 479px) {
    .diff-row {
      flex-direction: column;
      gap: var(--space-4);
    }
  }

  /* CTA Card */
  .cta-card {
    position: relative;
    background: var(--xt-bg-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-8);
    text-align: center;
    overflow: hidden;
  }

  .cta-card__glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 200px;
    background: radial-gradient(ellipse at center, rgba(24, 140, 255, 0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-card__content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-card h2 {
    margin: var(--space-4) 0 var(--space-6);
  }

  .cta-card p {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: var(--space-8);
  }

  .cta-card strong {
    color: var(--xt-accent-light);
  }

  /* Entrance (Linear-style rise on load) + cred-bar scroll reveal.
     animation-fill-mode: both hides each element during its stagger
     delay via the `from` frame. There is deliberately NO static
     opacity: 0 in the load sequence, so if animations never run
     (old browser, reader mode) the content is simply visible.
     .hero__visual carries the rise, NOT the tesseract inside it, whose
     transform is owned by its own float loop (two animations on one
     element fight over transform). */
  .hero,
  .cred-bar {
    --rise-distance: 56px;
    --rise-duration: 2200ms;
    --rise-ease: cubic-bezier(0.25, 0.46, 0.45, 0.94);
    --rise-step: 320ms;
  }

  /* The scroll reveal must not inherit the hero's ~3s pace — during
     active scrolling that reads as broken. Pinned at the previous
     roll-up values. */
  .cred-bar {
    --rise-duration: 1400ms;
    --rise-step: 220ms;
    --rise-distance: 40px;
  }

  .hero__title,
  .hero__subtitle,
  .hero__actions,
  .hero__visual {
    animation: rise var(--rise-duration) var(--rise-ease) both;
  }

  .hero__subtitle { animation-delay: var(--rise-step); }
  .hero__actions  { animation-delay: calc(var(--rise-step) * 2); }
  .hero__visual   { animation-delay: calc(var(--rise-step) * 3); }

  /* Ambient video knobs (consumed by AmbientVideo.astro, which inherits
     them). Intensity is --ambient-video-opacity; the fades are what keep
     text legible, and were set by measuring contrast against real frames:
     the subtitle is #a1a1aa, so whatever sits behind it has to stay dark.

     Single column (below 1024px): the clip is clamped to the first screen
     and fades in from the top, so light rises behind the CTAs and the
     top of the tesseract. svh, not dvh: the box must not resize when a mobile
     URL bar collapses. A browser without svh drops the clamp and the clip
     simply covers the whole hero. */
  .hero {
    --ambient-video-opacity: 0.92;
    --ambient-video-fade: 600ms;
    --ambient-video-rate: 0.7; /* full speed was dizzying (owner, 2026-09-22) */
    --ambient-max-height: calc(100svh - var(--header-height));
    --ambient-fade-top-start: 22%;
    --ambient-fade-top: 72%;
    --ambient-fade-bottom: 10%;
    --ambient-plate-size: 120% 46%;
    --ambient-plate-at: 50% 40%;
    --ambient-plate-strength: 80%;
  }

  /* Two columns: content fills both from top to bottom (measured: text
     11% to 92% of the hero height at 1280x800), so there is no free band.
     The light lives on the right, around the tesseract, and a left-to-right
     scrim keeps the text column on the page background. */
  @media (min-width: 1024px) {
    .hero {
      --ambient-video-opacity: 1;
      --ambient-max-height: none;
      --ambient-fade-left-start: 0%;
      --ambient-fade-left: 26%;
      --ambient-fade-top-start: 0%;
      --ambient-fade-top: 12%;
      --ambient-fade-bottom: 6%;
      --ambient-plate-size: 46% 64%;
      --ambient-plate-at: 25% 60%;
      --ambient-plate-strength: 76%;
    }
  }

  /* Tesseract knobs (consumed by HeroTesseract.astro, which inherits them;
     every knob is documented there). Measured columns: 448.5px at 1024,
     544px from 1280; the box fills the column from 1280 up (25% larger than
     the first cut, owner request, 2026-09-22). Below 1024 the cube sits under
     the CTAs. */
  .hero {
    --cube-size: min(90vw, 400px);
    --cube-logo: 0.34;
    --cube-yaw-period: 14s;
    --cube-4d-period: 22s;
    --cube-tilt: 18deg;
    --cube-glow: 1;
    --cube-backing: 0.2;
    --cube-pulses: 0;
    --cube-embers: 24;
    --cube-hover-boost: 1.6;
    --cube-scroll-spin: 0.002;
    --cube-entrance: 2000ms;
  }

  @media (min-width: 1024px) {
    .hero {
      --cube-size: clamp(375px, 42.5vw, 625px);
    }
  }

  /* The light now runs under the text, so the text carries its own
     separation instead of sitting on a wall of black: layered dark halos
     hugging the glyphs, the way film subtitles stay legible over anything.
     The subtitle also steps up from --xt-text-secondary, which was chosen
     for flat dark surfaces, not for moving light. */
  .hero__title,
  .hero__subtitle {
    text-shadow:
      0 0 3px color-mix(in srgb, var(--xt-bg-primary) 95%, transparent),
      0 0 10px color-mix(in srgb, var(--xt-bg-primary) 90%, transparent),
      0 0 26px color-mix(in srgb, var(--xt-bg-primary) 85%, transparent);
  }

  .hero__subtitle {
    color: color-mix(in srgb, var(--xt-text-primary) 80%, var(--xt-text-secondary));
  }

  /* The outline button is see-through everywhere else; over moving light
     it gets a smoked-glass backing (measured 3.7:1 without it at the ride's
     brightest frame). */
  .hero__actions .btn--secondary {
    background: color-mix(in srgb, var(--xt-bg-primary) 60%, transparent);
  }

  /* A text-shadow paints over a background-clip:text fill and muddies the
     gradient phrase; a drop-shadow filter acts on the finished glyphs. */
  .hero__title :global(.text-gradient) {
    text-shadow: none;
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--xt-bg-primary) 85%, transparent));
  }

  /* Pause control: top corner on the single-column layout (the 72px above
     the headline is the one area no wrapping text or the cube can reach),
     bottom corner below the cube column on desktop (measured: 59px clear of
     a 435px box at 1280x800). */
  .hero :global(.ambient-toggle) {
    top: var(--space-3);
    right: var(--space-3);
    bottom: auto;
  }

  @media (min-width: 1024px) {
    .hero :global(.ambient-toggle) {
      top: auto;
      right: var(--space-4);
      bottom: var(--space-4);
    }
  }

  .hero__bg {
    animation: bloom 2600ms ease-out both;
  }

  /* Cred bar: hidden only after JS arms it (below the fold, so the
     arming race is invisible); no JS or reduced motion = just visible. */
  .cred-bar__grid.is-pending .cred {
    opacity: 0;
  }

  .cred-bar__grid.is-revealed .cred {
    animation: rise var(--rise-duration) var(--rise-ease) both;
  }

  .cred-bar__grid.is-revealed .cred:nth-child(2) { animation-delay: var(--rise-step); }
  .cred-bar__grid.is-revealed .cred:nth-child(3) { animation-delay: calc(var(--rise-step) * 2); }
  .cred-bar__grid.is-revealed .cred:nth-child(4) { animation-delay: calc(var(--rise-step) * 3); }

  /* Opacity completes at the 60% keyframe while the translate runs the
     full duration, so each element is fully visible during the tail of
     its travel. That visible glide is what reads as "rolling up" rather
     than fading in; without it the eye only registers the fade. */
  @keyframes rise {
    from { opacity: 0; transform: translateY(var(--rise-distance)); }
    60%  { opacity: 1; }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes bloom {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
