---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import bartenderScreen from '../assets/my-ai-bartender-screen.png';

const title = 'Xtend-AI | Web & Mobile App Development in Charlotte, NC';
const description = 'Xtend-AI designs and builds websites, mobile apps, and the Azure cloud that runs them. Architected, not assembled. Charlotte & Harrisburg, NC, and remote.';

/**
 * Replaces the old Chat / Voice / Scan My Bar / Create bar, which was
 * My AI Bartender feature copy sitting on the company home page.
 *
 * Every value here is verifiable, and the 30 years is labelled as the
 * co-founder's career — not the company's age. Xtend-AI, LLC is young and
 * the copy must never blur the two.
 */
const credibility = [
  { value: 'Azure Certified', label: 'AZ-305 Solutions Architect Expert' },
  { value: '30 years', label: "Our co-founder's career in enterprise infrastructure" },
  { value: '2 apps shipped', label: 'Live on the App Store and Google Play' },
  { value: 'Charlotte / Harrisburg, NC', label: 'Local, and remote-friendly' }
];

const services = [
  {
    icon: 'web',
    title: 'Websites',
    description: 'Designed and built mobile-first. Fast, accessible, SEO-ready, and deployed as static files to a global CDN, not a page builder with a monthly subscription attached.'
  },
  {
    icon: 'mobile',
    title: 'Mobile apps',
    description: 'iOS and Android from a single Flutter codebase, with an Azure backend when the app needs one. We have shipped two of our own to both stores.'
  },
  {
    icon: 'cloud',
    title: 'Cloud & hosting',
    description: 'Azure architecture, infrastructure as code, custom domains and real DNS delegation, security headers, CI/CD on every push, and monitoring after launch.'
  }
];

const differentiators = [
  {
    icon: 'building',
    color: 'accent',
    title: 'Architected, not assembled',
    description: 'Static-first builds, infrastructure as code, real DNS delegation, security headers, CI/CD on every push, and per-client tenant isolation. The same discipline as enterprise systems, at the size of your business.'
  },
  {
    icon: 'puzzle',
    color: 'cyan',
    title: 'Both halves, one system',
    description: 'Website and mobile app on the same design system, with AI features only where they earn their place. One team, one look, one place to call.'
  },
  {
    icon: 'heart-handshake',
    color: 'green',
    title: 'Small, senior, direct',
    description: 'You talk to the architect who builds it. No account manager, and no handoff to a junior team after the pitch.'
  }
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__bg">
      <div class="hero__glow hero__glow--1"></div>
      <div class="hero__glow hero__glow--2"></div>
      <div class="hero__grid"></div>
    </div>
    <div class="hero__container container">
      <div class="hero__content">
        <h1 class="hero__title">
          Websites and apps, <span class="text-gradient">architected to last</span>
        </h1>
        <p class="hero__subtitle">
          Xtend-AI designs and builds websites, mobile apps, and the cloud infrastructure
          that runs them. Based in the Charlotte area, working with clients anywhere — and
          you deal directly with the architect who builds it.
        </p>
        <div class="hero__actions">
          <a href="/services" class="btn btn--primary btn--large">
            <span>See what we build</span>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="/contact" class="btn btn--secondary btn--large">Start a project</a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero__phone">
          <div class="hero__phone-fallback">
            {/* Real My AI Bartender home screen, cropped from the app's
                own store-listing screenshot (see scripts note in
                docs/IMPLEMENTATION.md). The capture ends below the
                Recipe Vault card; --xt-phone-screen-bg matches its page
                background so the frame's lower area reads as the same
                screen. */}
            <span class="hero__phone-screen">
              <Image
                src={bartenderScreen}
                alt="The My AI Bartender home screen"
                width={250}
                densities={[2]}
                loading="eager"
              />
            </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Credibility Bar -->
  <section class="cred-bar">
    <div class="container">
      <div class="cred-bar__grid">
        {credibility.map((item) => (
          <div class="cred">
            <strong class="cred__value">{item.value}</strong>
            <span class="cred__label">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What We Do Section -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div class="split__content">
          <h2>Websites, apps, and<br>the cloud beneath them.</h2>
          <p>
            Most shops build one of the three and hand off the rest. We build all three,
            because they are the same problem: a site that loads fast, an app that ships
            to both stores, and Azure infrastructure that holds them up.
          </p>
          <p>
            Designed together on one system, not bolted together after the fact.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Teaser -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <h2>What we build</h2>
      </div>

      <div class="grid grid--3">
        {services.map((service) => (
          <FeatureCard
            icon={service.icon}
            title={service.title}
            description={service.description}
            align="start"
          />
        ))}
      </div>

      <div class="section__cta text-center">
        <a href="/services" class="btn btn--secondary btn--large">See all services</a>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <h2>Work we're shipping</h2>
      </div>

      <div class="proof card">
        <p class="proof__text">
          We're building a website and a Flutter mobile app for <strong>Needle Girlie</strong>,
          a medical aesthetics practice in Harrisburg, NC. We've also shipped two apps of our
          own, <strong>My AI Bartender</strong> and <strong>CLIQUE Pix</strong>, live on the
          App Store and Google Play, with CLIQUE Pix also running on the web.
        </p>
        <a href="/work" class="btn btn--primary btn--large">
          See our work
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Why We're Different Section -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <h2>We don't assemble websites.<br>We architect systems.</h2>
      </div>

      <div class="diff-list">
        {differentiators.map((item) => (
          <div class="diff-row">
            <div class={`icon-circle icon-circle--${item.color}`}><Icon name={item.icon} /></div>
            <div class="diff-row__body">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-card__glow"></div>
        <div class="cta-card__content">
          <h2>Let's talk about your project</h2>
          <p>
            Tell us what you're trying to build. You'll get a straight answer about whether
            we're the right fit. If we are, you'll get an architecture, a timeline, and a number.
          </p>
          <a href="/contact" class="btn btn--primary btn--large">Start a project</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    /* dvh tracks the *visible* viewport on iOS (address bar collapse),
       so the CTA can't land below the fold on first paint. */
    min-height: calc(100dvh - var(--header-height));
    display: flex;
    align-items: center;
    padding: var(--space-12) 0;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.5;
  }

  .hero__glow--1 {
    width: 600px;
    height: 600px;
    background: var(--xt-accent);
    top: -200px;
    left: -200px;
    opacity: 0.15;
  }

  .hero__glow--2 {
    width: 500px;
    height: 500px;
    background: var(--xt-blue);
    bottom: -150px;
    right: -150px;
    opacity: 0.1;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(24, 140, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(24, 140, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }

  .hero__container {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__container {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero__content {
    text-align: center;
  }

  @media (min-width: 1024px) {
    .hero__content {
      text-align: left;
    }
  }

  .hero__title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin: var(--space-6) 0;
  }

  .hero__subtitle {
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    color: var(--xt-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-8);
    max-width: 540px;
  }

  @media (min-width: 1024px) {
    .hero__subtitle {
      margin-left: 0;
      margin-right: auto;
    }
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
  }

  @media (min-width: 480px) {
    .hero__actions {
      flex-direction: row;
    }
  }

  @media (min-width: 1024px) {
    .hero__actions {
      justify-content: flex-start;
    }
  }

  /* Hero Visual / Phone */
  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__phone {
    position: relative;
    width: 280px;
    height: 560px;
    background: var(--xt-bg-card);
    border-radius: 40px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    padding: 12px;
    box-shadow:
      0 50px 100px -20px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(24, 140, 255, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    animation: float 6s ease-in-out infinite;
  }

  .hero__phone-fallback {
    width: 100%;
    height: 100%;
    background: var(--xt-phone-screen-bg);
    border-radius: 28px;
    overflow: hidden;
  }

  .hero__phone-screen :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Credibility Bar */
  .cred-bar {
    padding: var(--space-8) 0;
    background: var(--xt-bg-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .cred-bar__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .cred-bar__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cred-bar__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cred {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 2px solid rgba(24, 140, 255, 0.4);
  }

  .cred__value {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--xt-text-primary);
  }

  .cred__label {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--xt-text-muted);
  }

  /* Split Content */
  .split {
    max-width: 700px;
  }

  .split__content h2 {
    margin: var(--space-4) 0 var(--space-6);
  }

  .split__content p {
    font-size: 1.125rem;
    line-height: 1.8;
  }

  /* Section Header */
  .section-header {
    margin-bottom: var(--space-12);
  }

  .section-header h2 {
    margin-bottom: var(--space-4);
  }

  /* Services teaser */
  .section__cta {
    margin-top: var(--space-12);
  }

  /* Proof */
  .proof {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-8);
    text-align: center;
  }

  .proof__text {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: var(--space-8);
  }

  .proof strong {
    color: var(--xt-accent-light);
    font-weight: 600;
  }

  /* Differentiators as editorial rows — the earlier three-equal-cards
     layout duplicated the services grid directly above it. */
  .diff-list {
    max-width: 800px;
    margin: 0 auto;
  }

  .diff-row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-6);
    padding: var(--space-8) 0;
  }

  .diff-row:first-child {
    padding-top: 0;
  }

  .diff-row:last-child {
    padding-bottom: 0;
  }

  .diff-row + .diff-row {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .diff-row h3 {
    margin-bottom: var(--space-2);
  }

  .diff-row p {
    margin: 0;
    line-height: 1.7;
  }

  @media (max-width: 479px) {
    .diff-row {
      flex-direction: column;
      gap: var(--space-4);
    }
  }

  /* CTA Card */
  .cta-card {
    position: relative;
    background: var(--xt-bg-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-8);
    text-align: center;
    overflow: hidden;
  }

  .cta-card__glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 200px;
    background: radial-gradient(ellipse at center, rgba(24, 140, 255, 0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-card__content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-card h2 {
    margin: var(--space-4) 0 var(--space-6);
  }

  .cta-card p {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: var(--space-8);
  }

  .cta-card strong {
    color: var(--xt-accent-light);
  }

  /* Float Animation */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }
</style>
