---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { Image } from 'astro:assets';
import bartenderIcon from '../assets/my-ai-bartender-icon.png';

const title = 'Xtend-AI | Web & Mobile App Development — Charlotte, NC';
const description = 'Xtend-AI designs and builds websites, mobile apps, and the Azure cloud that runs them — architected, not assembled. Charlotte & Harrisburg, NC, and remote.';

/**
 * Replaces the old Chat / Voice / Scan My Bar / Create bar, which was
 * My AI Bartender feature copy sitting on the company home page.
 *
 * Every value here is verifiable, and the 30 years is labelled as the
 * founder's career — not the company's age. Xtend-AI, LLC is young and
 * the copy must never blur the two.
 */
const credibility = [
  { value: 'Azure Certified', label: 'AZ-305 Solutions Architect Expert' },
  { value: '30 years', label: "The founder's career in enterprise infrastructure" },
  { value: '2 apps shipped', label: 'Live on the App Store and Google Play' },
  { value: 'Charlotte / Harrisburg, NC', label: 'Local, and remote-friendly' }
];

const services = [
  {
    icon: 'web',
    title: 'Websites',
    description: 'Designed and built mobile-first. Fast, accessible, SEO-ready, and deployed as static files to a global CDN — not a page builder with a monthly subscription attached.'
  },
  {
    icon: 'mobile',
    title: 'Mobile apps',
    description: 'iOS and Android from a single Flutter codebase, with an Azure backend when the app needs one. We have shipped two of our own to both stores.'
  },
  {
    icon: 'cloud',
    title: 'Cloud & hosting',
    description: 'Azure architecture, infrastructure as code, custom domains and real DNS delegation, security headers, CI/CD on every push, and monitoring after launch.'
  }
];

const differentiators = [
  {
    icon: '🏗️',
    color: 'accent',
    title: 'Architected, not assembled',
    description: 'Static-first builds, infrastructure as code, real DNS delegation, security headers, CI/CD on every push, and per-client tenant isolation. The same discipline as enterprise systems, at the size of your business.'
  },
  {
    icon: '🧩',
    color: 'cyan',
    title: 'Both halves, one system',
    description: 'Website and mobile app on the same design system, with AI features only where they earn their place. One team, one look, one place to call.'
  },
  {
    icon: '🤝',
    color: 'green',
    title: 'Small, senior, direct',
    description: 'You talk to the architect who builds it. No account manager, and no handoff to a junior team after the pitch.'
  }
];
---

<BaseLayout title={title} description={description}>
  <Header slot="header" />

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero__bg">
      <div class="hero__glow hero__glow--1"></div>
      <div class="hero__glow hero__glow--2"></div>
      <div class="hero__grid"></div>
    </div>
    <div class="hero__container container">
      <div class="hero__content">
        <span class="badge">Web · Mobile · Azure Cloud</span>
        <h1 class="hero__title">
          Websites and apps, <span class="text-gradient">architected to last</span>
        </h1>
        <p class="hero__subtitle">
          Xtend-AI designs and builds websites, mobile apps, and the cloud infrastructure
          that runs them. Based in the Charlotte area, working with clients anywhere — and
          you deal directly with the architect who builds it.
        </p>
        <div class="hero__actions">
          <a href="/services" class="btn btn--primary btn--large">
            <span>See what we build</span>
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="/contact" class="btn btn--secondary btn--large">Start a project</a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero__phone">
          <div class="hero__phone-fallback">
            <div class="phone-ui">
              <!-- App Header -->
              <div class="phone-ui__header">
                <div class="phone-ui__header-icon">
                  <Image
                    src={bartenderIcon}
                    alt=""
                    width={36}
                    height={36}
                    densities={[2, 3]}
                    loading="eager"
                  />
                </div>
                <div class="phone-ui__header-text">
                  <span class="phone-ui__title">My AI Bartender</span>
                  <span class="phone-ui__subtitle">Premium mixology experience</span>
                </div>
                <div class="phone-ui__header-profile">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="12" cy="8" r="4"/>
                    <path d="M4 20c0-4 4-6 8-6s8 2 8 6v1H4z"/>
                  </svg>
                </div>
              </div>

              <!-- AI Concierge Card -->
              <div class="phone-ui__concierge">
                <div class="phone-ui__concierge-icon">✨</div>
                <div class="phone-ui__concierge-text">
                  <span class="phone-ui__concierge-title">AI Cocktail Concierge</span>
                  <span class="phone-ui__concierge-desc">Sophisticated cocktail intelligence for the evening</span>
                </div>
              </div>

              <!-- Feature Grid -->
              <div class="phone-ui__features">
                <div class="phone-ui__feature">
                  <div class="phone-ui__feature-icon phone-ui__feature-icon--pink">📷</div>
                  <span class="phone-ui__feature-label">Scan My Bar</span>
                  <span class="phone-ui__feature-desc">Identify bottles</span>
                </div>
                <div class="phone-ui__feature">
                  <div class="phone-ui__feature-icon phone-ui__feature-icon--accent">✨</div>
                  <span class="phone-ui__feature-label">Create</span>
                  <span class="phone-ui__feature-desc">Design cocktails</span>
                </div>
                <div class="phone-ui__feature">
                  <div class="phone-ui__feature-icon phone-ui__feature-icon--teal">💬</div>
                  <span class="phone-ui__feature-label">Chat</span>
                  <span class="phone-ui__feature-desc">Text conversation</span>
                </div>
                <div class="phone-ui__feature">
                  <div class="phone-ui__feature-icon phone-ui__feature-icon--blue">🎙️</div>
                  <span class="phone-ui__feature-label">Voice</span>
                  <span class="phone-ui__feature-desc">Talk to AI</span>
                </div>
              </div>

              <!-- Lounge Section -->
              <div class="phone-ui__lounge">
                <span class="phone-ui__lounge-title">The Lounge</span>
                <div class="phone-ui__lounge-card">
                  <div class="phone-ui__lounge-icon phone-ui__lounge-icon--gold">📚</div>
                  <div>
                    <span class="phone-ui__lounge-label">Recipe Vault</span>
                    <span class="phone-ui__lounge-desc">Curated cocktail collection</span>
                  </div>
                </div>
                <div class="phone-ui__lounge-grid">
                  <div class="phone-ui__lounge-item">
                    <div class="phone-ui__lounge-icon phone-ui__lounge-icon--teal">🗂️</div>
                    <span class="phone-ui__lounge-label">My Bar</span>
                    <span class="phone-ui__lounge-desc">Track your collection</span>
                  </div>
                  <div class="phone-ui__lounge-item">
                    <div class="phone-ui__lounge-icon phone-ui__lounge-icon--red">❤️</div>
                    <span class="phone-ui__lounge-label">Favorites</span>
                    <span class="phone-ui__lounge-desc">Saved cocktails</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Credibility Bar -->
  <section class="cred-bar">
    <div class="container">
      <div class="cred-bar__grid">
        {credibility.map((item) => (
          <div class="cred">
            <strong class="cred__value">{item.value}</strong>
            <span class="cred__label">{item.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What We Do Section -->
  <section class="section section--glow">
    <div class="container">
      <div class="split">
        <div class="split__content">
          <span class="badge badge--gold">What We Do</span>
          <h2>Websites, apps, and<br><span class="text-gradient">the cloud beneath them.</span></h2>
          <p>
            Most shops build one of the three and hand off the rest. We build all three,
            because they are the same problem: a site that loads fast, an app that ships
            to both stores, and Azure infrastructure that holds them up.
          </p>
          <p>
            Designed together, on one system — not bolted together after the fact.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services Teaser -->
  <section class="section">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge">Services</span>
        <h2>What we build</h2>
      </div>

      <div class="grid grid--3">
        {services.map((service) => (
          <FeatureCard
            icon={service.icon}
            title={service.title}
            description={service.description}
            align="start"
          />
        ))}
      </div>

      <div class="section__cta text-center">
        <a href="/services" class="btn btn--secondary btn--large">See all services</a>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="section section--glow">
    <div class="container">
      <div class="section-header text-center">
        <span class="badge badge--gold">Proof</span>
        <h2>Work we're shipping</h2>
      </div>

      <div class="proof card">
        <p class="proof__text">
          We're building a website and a Flutter mobile app for <strong>Needle Girlie</strong>,
          a medical aesthetics practice in Harrisburg, NC. We've also shipped two apps of our
          own — <strong>My AI Bartender</strong> and <strong>CLIQUE Pix</strong> — live on the
          App Store and Google Play, with CLIQUE Pix also running on the web.
        </p>
        <a href="/work" class="btn btn--primary btn--large">
          See our work
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Why We're Different Section -->
  <section class="section section--glow">
    <div class="container">
      <div class="section-header text-center">
        <h2>We don't assemble websites.<br><span class="text-gradient">We architect systems.</span></h2>
      </div>

      <div class="grid grid--3">
        {differentiators.map((item) => (
          <div class="card card--glow">
            <div class={`icon-circle icon-circle--${item.color}`}>{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-card">
        <div class="cta-card__glow"></div>
        <div class="cta-card__content">
          <h2>Let's talk about your project</h2>
          <p>
            Tell us what you're trying to build. You'll get a straight answer about whether
            we're the right fit — and if we are, an architecture, a timeline, and a number.
          </p>
          <a href="/contact" class="btn btn--primary btn--large">Start a project</a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: calc(100vh - var(--header-height));
    display: flex;
    align-items: center;
    padding: var(--space-12) 0;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.5;
  }

  .hero__glow--1 {
    width: 600px;
    height: 600px;
    background: var(--xt-accent);
    top: -200px;
    left: -200px;
    opacity: 0.15;
  }

  .hero__glow--2 {
    width: 500px;
    height: 500px;
    background: var(--xt-blue);
    bottom: -150px;
    right: -150px;
    opacity: 0.1;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(24, 140, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(24, 140, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse at center, black 0%, transparent 70%);
  }

  .hero__container {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero__container {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero__content {
    text-align: center;
  }

  @media (min-width: 1024px) {
    .hero__content {
      text-align: left;
    }
  }

  .hero__title {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin: var(--space-6) 0;
  }

  .hero__subtitle {
    font-size: clamp(1.125rem, 2vw, 1.25rem);
    color: var(--xt-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-8);
    max-width: 540px;
  }

  @media (min-width: 1024px) {
    .hero__subtitle {
      margin-left: 0;
      margin-right: auto;
    }
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: center;
  }

  @media (min-width: 480px) {
    .hero__actions {
      flex-direction: row;
    }
  }

  @media (min-width: 1024px) {
    .hero__actions {
      justify-content: flex-start;
    }
  }

  /* Hero Visual / Phone */
  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero__phone {
    position: relative;
    width: 280px;
    height: 560px;
    background: var(--xt-bg-card);
    border-radius: 40px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    padding: 12px;
    box-shadow:
      0 50px 100px -20px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(24, 140, 255, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    animation: float 6s ease-in-out infinite;
  }

  .hero__phone-fallback {
    width: 100%;
    height: 100%;
    background: #0d0d14;
    border-radius: 28px;
    padding: 16px 12px;
    overflow: hidden;
  }

  .phone-ui {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    font-size: 11px;
  }

  /* App Header */
  .phone-ui__header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 8px;
  }

  .phone-ui__header-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .phone-ui__header-icon :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .phone-ui__header-text {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .phone-ui__header-profile {
    width: 30px;
    height: 30px;
    background: var(--xt-green);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    flex-shrink: 0;
  }

  .phone-ui__header-profile svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .phone-ui__title {
    font-weight: 700;
    font-size: 14px;
    color: #fff;
  }

  .phone-ui__subtitle {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
  }

  /* AI Concierge Card */
  .phone-ui__concierge {
    background: linear-gradient(135deg, rgba(24, 140, 255, 0.25) 0%, rgba(59, 130, 246, 0.15) 100%);
    border-radius: 14px;
    padding: 14px;
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .phone-ui__concierge-icon {
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #188CFF 0%, #022A56 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  .phone-ui__concierge-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .phone-ui__concierge-title {
    font-weight: 600;
    font-size: 12px;
    color: #fff;
  }

  .phone-ui__concierge-desc {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.3;
  }

  /* Feature Grid */
  .phone-ui__features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .phone-ui__feature {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .phone-ui__feature-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
  }

  .phone-ui__feature-icon--pink { background: #f472b6; }
  .phone-ui__feature-icon--accent { background: #188CFF; }
  .phone-ui__feature-icon--teal { background: #14b8a6; }
  .phone-ui__feature-icon--blue { background: #3b82f6; }

  .phone-ui__feature-label {
    font-weight: 600;
    font-size: 11px;
    color: #fff;
  }

  .phone-ui__feature-desc {
    font-size: 9px;
    color: rgba(255, 255, 255, 0.5);
  }

  /* Lounge Section */
  .phone-ui__lounge {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .phone-ui__lounge-title {
    font-weight: 700;
    font-size: 13px;
    color: #fff;
    margin-bottom: 4px;
  }

  .phone-ui__lounge-card {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.2) 0%, rgba(59, 130, 246, 0.1) 100%);
    border-radius: 12px;
    padding: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .phone-ui__lounge-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }

  .phone-ui__lounge-icon--gold { background: #eab308; }
  .phone-ui__lounge-icon--teal { background: #14b8a6; }
  .phone-ui__lounge-icon--red { background: #ef4444; }

  .phone-ui__lounge-label {
    font-weight: 600;
    font-size: 11px;
    color: #fff;
    display: block;
  }

  .phone-ui__lounge-desc {
    font-size: 9px;
    color: rgba(255, 255, 255, 0.5);
    display: block;
  }

  .phone-ui__lounge-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }

  .phone-ui__lounge-item {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 14px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    text-align: center;
  }

  /* Credibility Bar */
  .cred-bar {
    padding: var(--space-8) 0;
    background: var(--xt-bg-secondary);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .cred-bar__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .cred-bar__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .cred-bar__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .cred {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 2px solid rgba(24, 140, 255, 0.4);
  }

  .cred__value {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--xt-text-primary);
  }

  .cred__label {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--xt-text-muted);
  }

  /* Split Content */
  .split {
    max-width: 700px;
  }

  .split__content h2 {
    margin: var(--space-4) 0 var(--space-6);
  }

  .split__content p {
    font-size: 1.125rem;
    line-height: 1.8;
  }

  /* Section Header */
  .section-header {
    margin-bottom: var(--space-12);
  }

  .section-header h2 {
    margin-bottom: var(--space-4);
  }

  /* Services teaser */
  .section__cta {
    margin-top: var(--space-12);
  }

  /* Proof */
  .proof {
    max-width: 760px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-8);
    text-align: center;
  }

  .proof__text {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: var(--space-8);
  }

  .proof strong {
    color: var(--xt-accent-light);
    font-weight: 600;
  }

  /* Cards with icons */
  .card .icon-circle {
    margin-bottom: var(--space-4);
    font-size: 1.5rem;
  }

  .card h3 {
    margin-bottom: var(--space-2);
  }

  .card p {
    margin: 0;
  }

  /* CTA Card */
  .cta-card {
    position: relative;
    background: var(--xt-bg-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    padding: var(--space-12) var(--space-8);
    text-align: center;
    overflow: hidden;
  }

  .cta-card__glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 200px;
    background: radial-gradient(ellipse at center, rgba(24, 140, 255, 0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-card__content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-card h2 {
    margin: var(--space-4) 0 var(--space-6);
  }

  .cta-card p {
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: var(--space-8);
  }

  .cta-card strong {
    color: var(--xt-accent-light);
  }

  /* Float Animation */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }
</style>
