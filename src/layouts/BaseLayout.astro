---
interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = '/images/xtend-ai_logo_transparent_cropped.png' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

/**
 * Organization identity, emitted on every page (brief §11: name, URL,
 * logo — nothing invented beyond those).
 */
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Xtend-AI',
  url: Astro.site?.toString(),
  logo: new URL('/images/xtend-ai_logo_transparent_cropped.png', Astro.site).toString()
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL}>

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/xtend-ai_favicon_32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/xtend-ai_favicon_16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/xtend-ai_favicon_180.png">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(ogImage, Astro.site)}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={new URL(ogImage, Astro.site)}>

  <!-- Fonts — self-hosted variable woff2 (see global.css @font-face).
       Preloaded so the fetch starts at HTML parse time instead of after
       the stylesheet is parsed. `crossorigin` is required on font
       preloads even same-origin, or the browser fetches twice. -->
  <link rel="preload" href="/fonts/sora-var.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-var.woff2" as="font" type="font/woff2" crossorigin>

  <!-- Structured data. is:inline + set:html: Astro must not bundle this,
       and the JSON must land unescaped. -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

  <!-- Pages can contribute page-specific head markup (e.g. extra JSON-LD) -->
  <slot name="head" />

  <title>{title}</title>
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>

  <slot name="header" />

  <main id="main">
    <slot />
  </main>

  <slot name="footer" />
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
